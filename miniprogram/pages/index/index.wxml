<!--index.wxml-->
<navigation-bar title="登录" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<view class="login-page">
  <view class="login-card">
    <view class="login-title">欢迎使用</view>
    <view class="login-desc">授权微信头像和昵称后进入主页</view>
    <button
      wx:if="{{canIUseGetUserProfile}}"
      class="login-button"
      loading="{{isLoggingIn}}"
      disabled="{{isLoggingIn}}"
      bindtap="loginWithWechat"
    >
      微信授权登录
    </button>
    <view wx:else class="unsupported-tip">当前基础库不支持微信授权登录，请升级微信版本</view>
  </view>
</view>
