<view class="page-top-bar"></view>
<view class="industry-page">
  <view class="hero-card">
    <view class="hero-brand">
      <image class="hero-logo" src="/assets/logo/logo_v1.png" mode="aspectFit"></image>
      <text class="brand-text">compass</text>
    </view>
    <view class="hero-title">AI 产业投资转折点研究</view>
    <view class="hero-desc">联网核验最新公开数据，生成买方调研报告，寻找尚未充分定价的交易机会。</view>
    <van-button
      custom-class="hero-button"
      type="primary"
      round
      block
      size="large"
      disabled="{{isAnalyzing || canDownloadPdf}}"
      bind:click="runIndustryAnalysis"
    >
      {{isAnalyzing ? '正在生成报告' : canDownloadPdf ? '报告生成完毕' : '开始生成报告'}}
    </van-button>
  </view>

  <view wx:if="{{hasReport}}" class="report-card">
    <view class="report-switch">
      <view
        wx:for="{{reportTabs}}"
        wx:key="type"
        class="report-switch-item {{activeReportType === item.type ? 'is-active' : ''}} {{isAnalyzing ? 'is-disabled' : ''}}"
        data-report-type="{{item.type}}"
        bindtap="switchReportType"
      >
        {{item.label}}
      </view>
    </view>

    <mp-html content="{{reportHtml}}" tag-style="{{reportTagStyle}}" />
  </view>
</view>
